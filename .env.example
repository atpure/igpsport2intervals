# iGPSPORT Credentials (Required - Mobile App Account)
IGPSPORT_USER=your_app_email
IGPSPORT_PASS=your_app_password

# Intervals.icu Credentials (Required)
INTERVALS_API_KEY=your_intervals_api_key
INTERVALS_ATHLETE_ID=0

# Strava Credentials (Optional: Uploads 30s after Intervals.icu)
# If left empty, syncs to Intervals.icu only.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_CLIENT_REFRESH_TOKEN=
